+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::pdu::WaveFormat;
+
+    #[derive(Debug)]
+    struct TestHandler {
+        formats: Vec<AudioFormat>,
+    }
+
+    impl RdpsndClientHandler for TestHandler {
+        fn get_formats(&self) -> &[AudioFormat] {
+            &self.formats
+        }
+
+        fn wave(&mut self, _format: &AudioFormat, _ts: u32, _data: Cow<'_, [u8]>) {}
+
+        fn set_volume(&mut self, _volume: VolumePdu) {}
+
+        fn set_pitch(&mut self, _pitch: PitchPdu) {}
+
+        fn close(&mut self) {}
+    }
+
+    fn audio_format(format: WaveFormat, sample_rate: u32) -> AudioFormat {
+        AudioFormat {
+            format,
+            n_channels: 2,
+            n_samples_per_sec: sample_rate,
+            n_avg_bytes_per_sec: sample_rate * 4,
+            n_block_align: 4,
+            bits_per_sample: 16,
+            data: None,
+        }
+    }
+
+    #[test]
+    fn negotiated_format_numbers_index_client_format_list() {
+        let pcm = audio_format(WaveFormat::PCM, 44_100);
+        let unsupported = audio_format(WaveFormat::ALAW, 44_100);
+        let mut rdpsnd = Rdpsnd::new(Box::new(TestHandler {
+            formats: vec![pcm.clone()],
+        }));
+        rdpsnd.server_format = Some(ServerAudioFormatPdu {
+            version: pdu::Version::V8,
+            formats: vec![unsupported, pcm.clone()],
+        });
+
+        let _ = rdpsnd.client_formats().expect("format negotiation succeeds");
+
+        let selected = rdpsnd.get_format(0).expect("format 0 is negotiated");
+        assert_eq!(pcm, *selected);
+    }
+}
