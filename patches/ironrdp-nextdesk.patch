diff --git a/crates/ironrdp-web/src/rdpdr.rs b/crates/ironrdp-web/src/rdpdr.rs
new file mode 100644
index 0000000..1b26405
--- /dev/null
+++ b/crates/ironrdp-web/src/rdpdr.rs
@@ -0,0 +1,610 @@
+//! WASM-compatible RDPDR (Drive Redirection) backend.
+//!
+//! File reads are handled asynchronously: when Windows requests data for
+//! an uncached file, we return no response synchronously and instead
+//! spawn an async task that awaits the JS Promise, then injects the
+//! RDPDR DeviceReadResponse back through the session's input event channel.
+
+use std::cell::RefCell;
+use std::collections::HashMap;
+use std::rc::Rc;
+
+use futures_channel::mpsc;
+use ironrdp::pdu::PduResult;
+use ironrdp::rdpdr::RdpdrBackend;
+use ironrdp::rdpdr::pdu::RdpdrPdu;
+use ironrdp::rdpdr::pdu::efs::*;
+use ironrdp::rdpdr::pdu::esc::{ScardCall, ScardIoCtlCode};
+use ironrdp::svc::SvcMessage;
+use tracing::{debug, warn, info};
+use wasm_bindgen::prelude::*;
+use wasm_bindgen_futures::JsFuture;
+
+/// A file entry stored in memory.
+#[derive(Debug, Clone)]
+pub(crate) struct MemFileEntry {
+    pub path: String,
+    pub is_dir: bool,
+    pub data: Vec<u8>,
+    pub size: u64,
+    pub creation_time: i64,
+    pub last_access_time: i64,
+    pub last_write_time: i64,
+}
+
+/// Channel message for deferred RDPDR responses.
+#[derive(Debug)]
+pub(crate) enum RdpdrDeferredMessage {
+    /// Deferred SVC messages to be encoded and sent to the server
+    Response(Vec<SvcMessage>),
+}
+
+/// WASM RDPDR backend using in-memory file data + async on-demand reads.
+pub(crate) struct WasmRdpdrBackend {
+    file_id_counter: u32,
+    /// file_id -> MemFileEntry
+    file_map: HashMap<u32, MemFileEntry>,
+    /// All known entries (relative path -> entry)
+    entries: HashMap<String, MemFileEntry>,
+    /// file_id -> relative path
+    id_to_path: HashMap<u32, String>,
+    /// file_id -> read cursor offset
+    read_offsets: HashMap<u32, u64>,
+    /// file_id -> directory listing iterator index
+    dir_iters: HashMap<u32, Vec<String>>,
+    /// JS callback for write operations
+    write_callback: Option<js_sys::Function>,
+    /// JS async callback for on-demand file read: fn(path, offset, length) -> Promise<Uint8Array>
+    read_callback: Option<js_sys::Function>,
+    /// Channel to send deferred responses back to the session event loop
+    deferred_tx: Rc<RefCell<mpsc::UnboundedSender<RdpdrDeferredMessage>>>,
+}
+
+// Manual AsAny implementation for WASM (can't use impl_as_any! macro)
+impl ironrdp::core::AsAny for WasmRdpdrBackend {
+    fn as_any(&self) -> &dyn std::any::Any {
+        self
+    }
+
+    fn as_any_mut(&mut self) -> &mut dyn std::any::Any {
+        self
+    }
+}
+
+// SAFETY: WASM is single-threaded, so Send is safe.
+unsafe impl Send for WasmRdpdrBackend {}
+
+// Manual Debug implementation (deferred_tx doesn't implement Debug)
+impl std::fmt::Debug for WasmRdpdrBackend {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("WasmRdpdrBackend")
+            .field("file_id_counter", &self.file_id_counter)
+            .field("entries_count", &self.entries.len())
+            .field("open_files", &self.file_map.len())
+            .finish()
+    }
+}
+
+impl WasmRdpdrBackend {
+    pub(crate) fn new(
+        _file_base: String,
+        write_callback: Option<js_sys::Function>,
+        read_callback: Option<js_sys::Function>,
+        deferred_tx: mpsc::UnboundedSender<RdpdrDeferredMessage>,
+    ) -> Self {
+        Self {
+            file_id_counter: 0,
+            file_map: HashMap::new(),
+            entries: HashMap::new(),
+            id_to_path: HashMap::new(),
+            read_offsets: HashMap::new(),
+            dir_iters: HashMap::new(),
+            write_callback,
+            read_callback,
+            deferred_tx: Rc::new(RefCell::new(deferred_tx)),
+        }
+    }
+
+    /// Add a pre-loaded file entry.
+    pub(crate) fn add_entry(&mut self, entry: MemFileEntry) {
+        self.entries.insert(entry.path.clone(), entry);
+    }
+
+    fn next_file_id(&mut self) -> u32 {
+        let id = self.file_id_counter;
+        self.file_id_counter += 1;
+        id
+    }
+
+    fn get_full_path(&self, rdp_path: &str) -> String {
+        let clean = rdp_path.replace('\\', "/");
+        if clean.starts_with('/') {
+            clean[1..].to_string()
+        } else {
+            clean
+        }
+    }
+
+    fn children_of(&self, dir_path: &str) -> Vec<String> {
+        let prefix = if dir_path.is_empty() {
+            String::new()
+        } else if dir_path.ends_with('/') {
+            dir_path.to_string()
+        } else {
+            format!("{}/", dir_path)
+        };
+        self.entries
+            .keys()
+            .filter(|k| {
+                if prefix.is_empty() {
+                    !k.contains('/')
+                } else {
+                    k.starts_with(&prefix) && !k[prefix.len()..].contains('/')
+                }
+            })
+            .cloned()
+            .collect()
+    }
+
+    /// Spawn an async task to read file data via JS callback (returns Promise).
+    /// The result is sent back through the deferred_tx channel as a DeviceReadResponse.
+    fn spawn_deferred_read(
+        &self,
+        req_header: DeviceIoRequest,
+        path: String,
+        offset: u64,
+        length: u32,
+    ) {
+        let cb = match self.read_callback.as_ref() {
+            Some(cb) => cb.clone(),
+            None => {
+                warn!("[rdpdr-wasm] no read callback, cannot read {}", path);
+                return;
+            }
+        };
+        let tx = self.deferred_tx.clone();
+
+        wasm_bindgen_futures::spawn_local(async move {
+            let promise_result = cb.call3(
+                &JsValue::NULL,
+                &JsValue::from_str(&path),
+                &JsValue::from(offset as f64),
+                &JsValue::from(length as f64),
+            );
+
+            let read_data = match promise_result {
+                Ok(val) => {
+                    // The JS callback returns a Promise<Uint8Array>
+                    let promise = js_sys::Promise::from(val);
+                    match JsFuture::from(promise).await {
+                        Ok(resolved) => {
+                            let arr = js_sys::Uint8Array::from(resolved);
+                            arr.to_vec()
+                        }
+                        Err(e) => {
+                            warn!("[rdpdr-wasm] async read failed for {}: {:?}", path, e);
+                            Vec::new()
+                        }
+                    }
+                }
+                Err(e) => {
+                    warn!("[rdpdr-wasm] read callback call failed for {}: {:?}", path, e);
+                    Vec::new()
+                }
+            };
+
+            info!(
+                "[rdpdr-wasm] async read complete: {} offset={} got {} bytes",
+                path, offset, read_data.len()
+            );
+
+            let response = SvcMessage::from(RdpdrPdu::DeviceReadResponse(
+                DeviceReadResponse {
+                    device_io_reply: DeviceIoResponse::new(req_header, NtStatus::SUCCESS),
+                    read_data,
+                },
+            ));
+
+            let sender = tx.borrow();
+            let _ = sender.unbounded_send(RdpdrDeferredMessage::Response(vec![response]));
+        });
+    }
+}
+
+fn filetime_now() -> i64 {
+    // Approximate: seconds since Unix epoch * 10M + Windows epoch offset
+    let js_ms = js_sys::Date::now() as i64;
+    let secs = js_ms / 1000;
+    secs * 10_000_000 + 116_444_736_000_000_000
+}
+
+impl RdpdrBackend for WasmRdpdrBackend {
+    fn handle_server_device_announce_response(&mut self, _pdu: ServerDeviceAnnounceResponse) -> PduResult<()> {
+        debug!("[rdpdr-wasm] device announce response");
+        Ok(())
+    }
+
+    fn handle_scard_call(&mut self, _req: DeviceControlRequest<ScardIoCtlCode>, _call: ScardCall) -> PduResult<()> {
+        Ok(())
+    }
+
+    fn handle_drive_io_request(&mut self, req: ServerDriveIoRequest) -> PduResult<Vec<SvcMessage>> {
+        debug!("[rdpdr-wasm] drive_io_request: {:?}", req);
+        match req {
+            ServerDriveIoRequest::ServerCreateDriveRequest(r) => self.handle_create(r),
+            ServerDriveIoRequest::DeviceReadRequest(r) => self.handle_read(r),
+            ServerDriveIoRequest::DeviceWriteRequest(r) => self.handle_write(r),
+            ServerDriveIoRequest::DeviceCloseRequest(r) => self.handle_close(r),
+            ServerDriveIoRequest::ServerDriveQueryInformationRequest(r) => self.handle_query_info(r),
+            ServerDriveIoRequest::ServerDriveQueryDirectoryRequest(r) => self.handle_query_dir(r),
+            ServerDriveIoRequest::ServerDriveQueryVolumeInformationRequest(r) => self.handle_query_volume(r),
+            ServerDriveIoRequest::DeviceControlRequest(r) => Ok(vec![SvcMessage::from(
+                RdpdrPdu::DeviceControlResponse(DeviceControlResponse {
+                    device_io_reply: DeviceIoResponse::new(r.header, NtStatus::SUCCESS),
+                    output_buffer: None,
+                }),
+            )]),
+            ServerDriveIoRequest::ServerDriveSetInformationRequest(r) => self.handle_set_info(r),
+            _ => {
+                warn!("[rdpdr-wasm] unhandled io request");
+                Ok(Vec::new())
+            }
+        }
+    }
+}
+
+// ── Individual request handlers ──
+
+impl WasmRdpdrBackend {
+    fn handle_create(&mut self, req: DeviceCreateRequest) -> PduResult<Vec<SvcMessage>> {
+        let file_id = self.next_file_id();
+        let rel_path = self.get_full_path(&req.path);
+
+        if let Some(entry) = self.entries.get(&rel_path).cloned() {
+            // Insert entry as-is; data will be fetched on-demand via async read
+            self.file_map.insert(file_id, entry);
+            self.id_to_path.insert(file_id, rel_path);
+
+            let info = if req.create_disposition == CreateDisposition::FILE_OPEN_IF {
+                Information::FILE_OPENED
+            } else {
+                Information::FILE_SUPERSEDED
+            };
+
+            return Ok(vec![SvcMessage::from(RdpdrPdu::DeviceCreateResponse(
+                DeviceCreateResponse {
+                    device_io_reply: DeviceIoResponse::new(req.device_io_request, NtStatus::SUCCESS),
+                    file_id,
+                    information: info,
+                },
+            ))]);
+        }
+
+        // Path not found — check if it's a root/empty path
+        if rel_path.is_empty() {
+            let root = MemFileEntry {
+                path: String::new(),
+                is_dir: true,
+                data: Vec::new(),
+                size: 0,
+                creation_time: filetime_now(),
+                last_access_time: filetime_now(),
+                last_write_time: filetime_now(),
+            };
+            self.file_map.insert(file_id, root);
+            self.id_to_path.insert(file_id, rel_path);
+            return Ok(vec![SvcMessage::from(RdpdrPdu::DeviceCreateResponse(
+                DeviceCreateResponse {
+                    device_io_reply: DeviceIoResponse::new(req.device_io_request, NtStatus::SUCCESS),
+                    file_id,
+                    information: Information::FILE_OPENED,
+                },
+            ))]);
+        }
+
+        // File doesn't exist
+        warn!("[rdpdr-wasm] create: no such path: {}", rel_path);
+        Ok(vec![SvcMessage::from(RdpdrPdu::DeviceCreateResponse(
+            DeviceCreateResponse {
+                device_io_reply: DeviceIoResponse::new(req.device_io_request, NtStatus::NO_SUCH_FILE),
+                file_id,
+                information: Information::empty(),
+            },
+        ))])
+    }
+
+    fn handle_read(&mut self, req: DeviceReadRequest) -> PduResult<Vec<SvcMessage>> {
+        let fid = req.device_io_request.file_id;
+        if let Some(entry) = self.file_map.get(&fid) {
+            let offset = req.offset as usize;
+            let len = req.length as usize;
+            let data = &entry.data;
+
+            if !data.is_empty() && offset < data.len() {
+                // Data already in memory — respond immediately
+                let end = std::cmp::min(offset + len, data.len());
+                let read_data = data[offset..end].to_vec();
+                Ok(vec![SvcMessage::from(RdpdrPdu::DeviceReadResponse(
+                    DeviceReadResponse {
+                        device_io_reply: DeviceIoResponse::new(req.device_io_request, NtStatus::SUCCESS),
+                        read_data,
+                    },
+                ))])
+            } else if entry.size > 0 {
+                // No data in memory — spawn async read, response will come later
+                if let Some(path) = self.id_to_path.get(&fid).cloned() {
+                    info!("[rdpdr-wasm] deferred read: {} offset={} len={}", path, req.offset, req.length);
+                    self.spawn_deferred_read(
+                        req.device_io_request,
+                        path,
+                        req.offset,
+                        req.length,
+                    );
+                    // Return empty vec — no synchronous response; async task will send it
+                    Ok(Vec::new())
+                } else {
+                    Ok(vec![SvcMessage::from(RdpdrPdu::DeviceReadResponse(
+                        DeviceReadResponse {
+                            device_io_reply: DeviceIoResponse::new(req.device_io_request, NtStatus::NO_SUCH_FILE),
+                            read_data: Vec::new(),
+                        },
+                    ))])
+                }
+            } else {
+                // Zero-size file
+                Ok(vec![SvcMessage::from(RdpdrPdu::DeviceReadResponse(
+                    DeviceReadResponse {
+                        device_io_reply: DeviceIoResponse::new(req.device_io_request, NtStatus::SUCCESS),
+                        read_data: Vec::new(),
+                    },
+                ))])
+            }
+        } else {
+            Ok(vec![SvcMessage::from(RdpdrPdu::DeviceReadResponse(
+                DeviceReadResponse {
+                    device_io_reply: DeviceIoResponse::new(req.device_io_request, NtStatus::NO_SUCH_FILE),
+                    read_data: Vec::new(),
+                },
+            ))])
+        }
+    }
+
+    fn handle_write(&mut self, req: DeviceWriteRequest) -> PduResult<Vec<SvcMessage>> {
+        let len = req.write_data.len() as u32;
+
+        // Notify JS side about the write
+        if let Some(cb) = &self.write_callback {
+            if let Some(path) = self.id_to_path.get(&req.device_io_request.file_id) {
+                let _ = cb.call3(
+                    &JsValue::NULL,
+                    &JsValue::from_str(path),
+                    &JsValue::from(req.offset as f64),
+                    &js_sys::Uint8Array::from(req.write_data.as_slice()).into(),
+                );
+            }
+        }
+
+        Ok(vec![SvcMessage::from(RdpdrPdu::DeviceWriteResponse(
+            DeviceWriteResponse {
+                device_io_reply: DeviceIoResponse::new(req.device_io_request, NtStatus::SUCCESS),
+                length: len,
+            },
+        ))])
+    }
+
+    fn handle_close(&mut self, req: DeviceCloseRequest) -> PduResult<Vec<SvcMessage>> {
+        let fid = req.device_io_request.file_id;
+        self.file_map.remove(&fid);
+        self.id_to_path.remove(&fid);
+        self.read_offsets.remove(&fid);
+        self.dir_iters.remove(&fid);
+        Ok(vec![SvcMessage::from(RdpdrPdu::DeviceCloseResponse(
+            DeviceCloseResponse {
+                device_io_response: DeviceIoResponse::new(req.device_io_request, NtStatus::SUCCESS),
+            },
+        ))])
+    }
+
+    fn handle_query_info(&mut self, req: ServerDriveQueryInformationRequest) -> PduResult<Vec<SvcMessage>> {
+        let fid = req.device_io_request.file_id;
+        if let Some(entry) = self.file_map.get(&fid) {
+            let file_attr = if entry.is_dir {
+                FileAttributes::FILE_ATTRIBUTE_DIRECTORY
+            } else {
+                FileAttributes::FILE_ATTRIBUTE_ARCHIVE
+            };
+
+            if req.file_info_class_lvl == FileInformationClassLevel::FILE_BASIC_INFORMATION {
+                let info = FileBasicInformation {
+                    creation_time: entry.creation_time,
+                    last_access_time: entry.last_access_time,
+                    last_write_time: entry.last_write_time,
+                    change_time: entry.last_write_time,
+                    file_attributes: file_attr,
+                };
+                return Ok(vec![SvcMessage::from(RdpdrPdu::ClientDriveQueryInformationResponse(
+                    ClientDriveQueryInformationResponse {
+                        device_io_response: DeviceIoResponse::new(req.device_io_request, NtStatus::SUCCESS),
+                        buffer: Some(FileInformationClass::Basic(info)),
+                    },
+                ))]);
+            }
+
+            if req.file_info_class_lvl == FileInformationClassLevel::FILE_STANDARD_INFORMATION {
+                let dir = if entry.is_dir { Boolean::True } else { Boolean::False };
+                let info = FileStandardInformation {
+                    allocation_size: entry.size as i64,
+                    end_of_file: entry.size as i64,
+                    number_of_links: 1,
+                    delete_pending: Boolean::False,
+                    directory: dir,
+                };
+                return Ok(vec![SvcMessage::from(RdpdrPdu::ClientDriveQueryInformationResponse(
+                    ClientDriveQueryInformationResponse {
+                        device_io_response: DeviceIoResponse::new(req.device_io_request, NtStatus::SUCCESS),
+                        buffer: Some(FileInformationClass::Standard(info)),
+                    },
+                ))]);
+            }
+
+            if req.file_info_class_lvl == FileInformationClassLevel::FILE_ATTRIBUTE_TAG_INFORMATION {
+                let info = FileAttributeTagInformation {
+                    file_attributes: file_attr,
+                    reparse_tag: 0,
+                };
+                return Ok(vec![SvcMessage::from(RdpdrPdu::ClientDriveQueryInformationResponse(
+                    ClientDriveQueryInformationResponse {
+                        device_io_response: DeviceIoResponse::new(req.device_io_request, NtStatus::SUCCESS),
+                        buffer: Some(FileInformationClass::AttributeTag(info)),
+                    },
+                ))]);
+            }
+
+            warn!("[rdpdr-wasm] unsupported info class");
+        }
+
+        Ok(vec![SvcMessage::from(RdpdrPdu::ClientDriveQueryInformationResponse(
+            ClientDriveQueryInformationResponse {
+                device_io_response: DeviceIoResponse::new(req.device_io_request, NtStatus::NO_SUCH_FILE),
+                buffer: None,
+            },
+        ))])
+    }
+
+    fn handle_query_dir(&mut self, req: ServerDriveQueryDirectoryRequest) -> PduResult<Vec<SvcMessage>> {
+        let fid = req.device_io_request.file_id;
+
+        if req.initial_query > 0 {
+            // Build directory listing
+            let dir_path = self.id_to_path.get(&fid).cloned().unwrap_or_default();
+            let children = self.children_of(&dir_path);
+            self.dir_iters.insert(fid, children);
+        }
+
+        // Get next entry from iterator
+        if let Some(listing) = self.dir_iters.get_mut(&fid) {
+            if let Some(child_path) = listing.pop() {
+                if let Some(entry) = self.entries.get(&child_path) {
+                    let name = child_path.rsplit('/').next().unwrap_or(&child_path);
+                    let file_attr = if entry.is_dir {
+                        FileAttributes::FILE_ATTRIBUTE_DIRECTORY
+                    } else {
+                        FileAttributes::FILE_ATTRIBUTE_ARCHIVE
+                    };
+                    let info = FileBothDirectoryInformation::new(
+                        entry.creation_time,
+                        entry.last_write_time,
+                        entry.last_access_time,
+                        entry.last_write_time,
+                        entry.size as i64,
+                        file_attr,
+                        name.to_string(),
+                    );
+                    return Ok(vec![SvcMessage::from(RdpdrPdu::ClientDriveQueryDirectoryResponse(
+                        ClientDriveQueryDirectoryResponse {
+                            device_io_reply: DeviceIoResponse::new(req.device_io_request, NtStatus::SUCCESS),
+                            buffer: Some(FileInformationClass::BothDirectory(info)),
+                        },
+                    ))]);
+                }
+            }
+        }
+
+        // No more entries
+        let status = if req.initial_query > 0 {
+            NtStatus::NO_SUCH_FILE
+        } else {
+            NtStatus::NO_MORE_FILES
+        };
+        Ok(vec![SvcMessage::from(RdpdrPdu::ClientDriveQueryDirectoryResponse(
+            ClientDriveQueryDirectoryResponse {
+                device_io_reply: DeviceIoResponse::new(req.device_io_request, status),
+                buffer: None,
+            },
+        ))])
+    }
+
+    fn handle_query_volume(&mut self, req: ServerDriveQueryVolumeInformationRequest) -> PduResult<Vec<SvcMessage>> {
+        if req.fs_info_class_lvl == FileSystemInformationClassLevel::FILE_FS_ATTRIBUTE_INFORMATION {
+            return Ok(vec![SvcMessage::from(
+                RdpdrPdu::ClientDriveQueryVolumeInformationResponse(ClientDriveQueryVolumeInformationResponse {
+                    device_io_reply: DeviceIoResponse::new(req.device_io_request, NtStatus::SUCCESS),
+                    buffer: Some(FileSystemInformationClass::FileFsAttributeInformation(
+                        FileFsAttributeInformation {
+                            file_system_attributes: FileSystemAttributes::FILE_CASE_SENSITIVE_SEARCH
+                                | FileSystemAttributes::FILE_CASE_PRESERVED_NAMES
+                                | FileSystemAttributes::FILE_UNICODE_ON_DISK,
+                            max_component_name_len: 260,
+                            file_system_name: "FAT32".to_owned(),
+                        },
+                    )),
+                }),
+            )]);
+        }
+
+        if req.fs_info_class_lvl == FileSystemInformationClassLevel::FILE_FS_VOLUME_INFORMATION {
+            return Ok(vec![SvcMessage::from(
+                RdpdrPdu::ClientDriveQueryVolumeInformationResponse(ClientDriveQueryVolumeInformationResponse {
+                    device_io_reply: DeviceIoResponse::new(req.device_io_request, NtStatus::SUCCESS),
+                    buffer: Some(FileSystemInformationClass::FileFsVolumeInformation(
+                        FileFsVolumeInformation {
+                            volume_creation_time: filetime_now(),
+                            volume_serial_number: 0x4E455854, // "NEXT"
+                            supports_objects: Boolean::False,
+                            volume_label: "NEXTDESK".to_owned(),
+                        },
+                    )),
+                }),
+            )]);
+        }
+
+        if req.fs_info_class_lvl == FileSystemInformationClassLevel::FILE_FS_FULL_SIZE_INFORMATION {
+            return Ok(vec![SvcMessage::from(
+                RdpdrPdu::ClientDriveQueryVolumeInformationResponse(ClientDriveQueryVolumeInformationResponse {
+                    device_io_reply: DeviceIoResponse::new(req.device_io_request, NtStatus::SUCCESS),
+                    buffer: Some(FileSystemInformationClass::FileFsFullSizeInformation(
+                        FileFsFullSizeInformation {
+                            total_alloc_units: 1_000_000,
+                            caller_available_alloc_units: 500_000,
+                            actual_available_alloc_units: 500_000,
+                            sectors_per_alloc_unit: 4096,
+                            bytes_per_sector: 1,
+                        },
+                    )),
+                }),
+            )]);
+        }
+
+        if req.fs_info_class_lvl == FileSystemInformationClassLevel::FILE_FS_SIZE_INFORMATION {
+            return Ok(vec![SvcMessage::from(
+                RdpdrPdu::ClientDriveQueryVolumeInformationResponse(ClientDriveQueryVolumeInformationResponse {
+                    device_io_reply: DeviceIoResponse::new(req.device_io_request, NtStatus::SUCCESS),
+                    buffer: Some(FileSystemInformationClass::FileFsSizeInformation(
+                        FileFsSizeInformation {
+                            total_alloc_units: 1_000_000,
+                            available_alloc_units: 500_000,
+                            sectors_per_alloc_unit: 4096,
+                            bytes_per_sector: 1,
+                        },
+                    )),
+                }),
+            )]);
+        }
+
+        warn!("[rdpdr-wasm] unsupported volume class");
+        Ok(vec![SvcMessage::from(
+            RdpdrPdu::ClientDriveQueryVolumeInformationResponse(ClientDriveQueryVolumeInformationResponse {
+                device_io_reply: DeviceIoResponse::new(req.device_io_request, NtStatus::UNSUCCESSFUL),
+                buffer: None,
+            }),
+        )])
+    }
+
+    fn handle_set_info(&mut self, req: ServerDriveSetInformationRequest) -> PduResult<Vec<SvcMessage>> {
+        // For WASM, we handle set-info minimally
+        use ironrdp::pdu::encode_err;
+        Ok(vec![SvcMessage::from(RdpdrPdu::ClientDriveSetInformationResponse(
+            ClientDriveSetInformationResponse::new(&req, NtStatus::SUCCESS).map_err(|e| encode_err!(e))?,
+        ))])
+    }
+}
diff --git a/crates/ironrdp-web/src/rdpsnd.rs b/crates/ironrdp-web/src/rdpsnd.rs
new file mode 100644
index 0000000..fabb2f0
--- /dev/null
+++ b/crates/ironrdp-web/src/rdpsnd.rs
@@ -0,0 +1,210 @@
+use std::borrow::Cow;
+
+use ironrdp_rdpsnd::client::RdpsndClientHandler;
+use ironrdp_rdpsnd::pdu::{AudioFormat, PitchPdu, VolumePdu, WaveFormat};
+use tracing::{debug, info, warn};
+use wasm_bindgen::JsValue;
+
+/// WASM-compatible RDPSND backend that forwards PCM audio data
+/// to JavaScript via a callback function.
+///
+/// The callback signature is:
+///   audioCallback(type: string, data: any)
+///
+/// Events:
+///   - "format": { channels, sampleRate, bitsPerSample }
+///   - "wave":   Uint8Array of PCM data
+///   - "volume": { left, right }  (0-65535)
+///   - "close":  null
+#[derive(Debug)]
+pub struct WasmRdpsndBackend {
+    callback: js_sys::Function,
+    formats: Vec<AudioFormat>,
+    active_format: Option<AudioFormat>,
+}
+
+impl WasmRdpsndBackend {
+    pub fn new(callback: js_sys::Function) -> Self {
+        // Advertise PCM formats the Web Audio API can handle
+        let formats = vec![
+            // 16-bit stereo 44100 Hz (CD quality)
+            AudioFormat {
+                format: WaveFormat::PCM,
+                n_channels: 2,
+                n_samples_per_sec: 44100,
+                n_avg_bytes_per_sec: 44100 * 2 * 2,
+                n_block_align: 4,
+                bits_per_sample: 16,
+                data: None,
+            },
+            // 16-bit stereo 48000 Hz
+            AudioFormat {
+                format: WaveFormat::PCM,
+                n_channels: 2,
+                n_samples_per_sec: 48000,
+                n_avg_bytes_per_sec: 48000 * 2 * 2,
+                n_block_align: 4,
+                bits_per_sample: 16,
+                data: None,
+            },
+            // 16-bit mono 44100 Hz
+            AudioFormat {
+                format: WaveFormat::PCM,
+                n_channels: 1,
+                n_samples_per_sec: 44100,
+                n_avg_bytes_per_sec: 44100 * 2,
+                n_block_align: 2,
+                bits_per_sample: 16,
+                data: None,
+            },
+            // 16-bit stereo 22050 Hz
+            AudioFormat {
+                format: WaveFormat::PCM,
+                n_channels: 2,
+                n_samples_per_sec: 22050,
+                n_avg_bytes_per_sec: 22050 * 2 * 2,
+                n_block_align: 4,
+                bits_per_sample: 16,
+                data: None,
+            },
+            // 8-bit mono 22050 Hz (low quality fallback)
+            AudioFormat {
+                format: WaveFormat::PCM,
+                n_channels: 1,
+                n_samples_per_sec: 22050,
+                n_avg_bytes_per_sec: 22050,
+                n_block_align: 1,
+                bits_per_sample: 8,
+                data: None,
+            },
+            // ALAW 8000 Hz mono (telephony)
+            AudioFormat {
+                format: WaveFormat::ALAW,
+                n_channels: 1,
+                n_samples_per_sec: 8000,
+                n_avg_bytes_per_sec: 8000,
+                n_block_align: 1,
+                bits_per_sample: 8,
+                data: None,
+            },
+            // MULAW 8000 Hz mono (telephony)
+            AudioFormat {
+                format: WaveFormat::MULAW,
+                n_channels: 1,
+                n_samples_per_sec: 8000,
+                n_avg_bytes_per_sec: 8000,
+                n_block_align: 1,
+                bits_per_sample: 8,
+                data: None,
+            },
+        ];
+        Self {
+            callback,
+            formats,
+            active_format: None,
+        }
+    }
+
+    fn invoke(&self, event_type: &str, data: JsValue) {
+        let args = js_sys::Array::from_iter([
+            JsValue::from_str(event_type),
+            data,
+        ]);
+        if let Err(e) = self.callback.apply(&JsValue::NULL, &args) {
+            warn!("rdpsnd callback error: {:?}", e);
+        }
+    }
+}
+
+impl RdpsndClientHandler for WasmRdpsndBackend {
+    fn get_formats(&self) -> &[AudioFormat] {
+        &self.formats
+    }
+
+    fn wave(&mut self, format: &AudioFormat, _ts: u32, data: Cow<'_, [u8]>) {
+        // Check if format changed from the previously active one
+        let format_changed = self.active_format.as_ref().map_or(true, |f| {
+            f.n_channels != format.n_channels
+                || f.n_samples_per_sec != format.n_samples_per_sec
+                || f.bits_per_sample != format.bits_per_sample
+                || f.format != format.format
+        });
+
+        if format_changed {
+            self.active_format = Some(format.clone());
+
+            // Notify JS of format change
+            let format_info = js_sys::Object::new();
+            js_sys::Reflect::set(
+                &format_info,
+                &"channels".into(),
+                &JsValue::from_f64(format.n_channels.into()),
+            ).ok();
+            js_sys::Reflect::set(
+                &format_info,
+                &"sampleRate".into(),
+                &JsValue::from_f64(format.n_samples_per_sec.into()),
+            ).ok();
+            js_sys::Reflect::set(
+                &format_info,
+                &"bitsPerSample".into(),
+                &JsValue::from_f64(format.bits_per_sample.into()),
+            ).ok();
+            let format_tag = format.format;
+            let tag_str = if format_tag == WaveFormat::PCM {
+                "pcm"
+            } else if format_tag == WaveFormat::ALAW {
+                "alaw"
+            } else if format_tag == WaveFormat::MULAW {
+                "mulaw"
+            } else if format_tag == WaveFormat::IEEE_FLOAT {
+                "float"
+            } else {
+                "unknown"
+            };
+            js_sys::Reflect::set(
+                &format_info,
+                &"formatTag".into(),
+                &JsValue::from_str(tag_str),
+            ).ok();
+            info!(
+                "rdpsnd: format changed - {} ch, {} Hz, {} bit, tag={}",
+                format.n_channels,
+                format.n_samples_per_sec,
+                format.bits_per_sample,
+                tag_str
+            );
+            self.invoke("format", format_info.into());
+        }
+
+        // Send PCM data as Uint8Array
+        let js_data = js_sys::Uint8Array::from(data.as_ref());
+        self.invoke("wave", js_data.into());
+    }
+
+    fn set_volume(&mut self, volume: VolumePdu) {
+        debug!("rdpsnd: set_volume {:?}", volume);
+        let vol_obj = js_sys::Object::new();
+        js_sys::Reflect::set(
+            &vol_obj,
+            &"left".into(),
+            &JsValue::from_f64(volume.volume_left.into()),
+        ).ok();
+        js_sys::Reflect::set(
+            &vol_obj,
+            &"right".into(),
+            &JsValue::from_f64(volume.volume_right.into()),
+        ).ok();
+        self.invoke("volume", vol_obj.into());
+    }
+
+    fn set_pitch(&mut self, pitch: PitchPdu) {
+        debug!("rdpsnd: set_pitch {:?}", pitch);
+    }
+
+    fn close(&mut self) {
+        info!("rdpsnd: close");
+        self.active_format = None;
+        self.invoke("close", JsValue::NULL);
+    }
+}
diff --git a/crates/ironrdp-web/src/rdpsnd_dvc.rs b/crates/ironrdp-web/src/rdpsnd_dvc.rs
new file mode 100644
index 0000000..bb4bea5
--- /dev/null
+++ b/crates/ironrdp-web/src/rdpsnd_dvc.rs
@@ -0,0 +1,99 @@
+/// RDPSND Dynamic Virtual Channel (DVC) wrapper.
+///
+/// Modern Windows RDP servers (Windows 10+) prefer sending audio over the
+/// `AUDIO_PLAYBACK_DVC` dynamic virtual channel instead of the legacy `rdpsnd`
+/// static virtual channel. This module wraps the existing `Rdpsnd` protocol
+/// state machine so that it can run over DRDYNVC.
+use ironrdp_core::{Encode, EncodeResult, WriteCursor, ensure_size, impl_as_any, AsAny};
+use ironrdp::pdu::PduResult;
+use ironrdp_rdpsnd::client::{Rdpsnd, RdpsndClientHandler};
+use tracing::warn;
+
+use ironrdp::dvc::{DvcProcessor, DvcMessage, DvcEncode};
+use ironrdp::svc::SvcProcessor;
+
+/// The DVC channel name used by Windows 10+ for audio playback
+pub const AUDIO_PLAYBACK_DVC_NAME: &str = "AUDIO_PLAYBACK_DVC";
+
+/// A raw-bytes wrapper that implements `DvcEncode` so we can return
+/// pre-encoded RDPSND PDU bytes as `DvcMessage`.
+struct RawRdpsndDvcMsg(Vec<u8>);
+
+impl Encode for RawRdpsndDvcMsg {
+    fn encode(&self, dst: &mut WriteCursor<'_>) -> EncodeResult<()> {
+        ensure_size!(in: dst, size: self.size());
+        dst.write_slice(&self.0);
+        Ok(())
+    }
+
+    fn name(&self) -> &'static str {
+        "RawRdpsndDvcMsg"
+    }
+
+    fn size(&self) -> usize {
+        self.0.len()
+    }
+}
+
+impl DvcEncode for RawRdpsndDvcMsg {}
+
+/// DVC processor that wraps the RDPSND protocol for `AUDIO_PLAYBACK_DVC`.
+///
+/// Internally delegates to `Rdpsnd` (the SVC processor) for PDU
+/// decoding/encoding, but adapts the I/O to the DVC messaging
+/// interface.
+#[derive(Debug)]
+pub struct RdpsndDvc {
+    inner: Rdpsnd,
+}
+
+impl RdpsndDvc {
+    pub fn new(handler: Box<dyn RdpsndClientHandler>) -> Self {
+        Self {
+            inner: Rdpsnd::new(handler),
+        }
+    }
+}
+
+impl_as_any!(RdpsndDvc);
+
+impl DvcProcessor for RdpsndDvc {
+    fn channel_name(&self) -> &str {
+        AUDIO_PLAYBACK_DVC_NAME
+    }
+
+    fn start(&mut self, _channel_id: u32) -> PduResult<Vec<DvcMessage>> {
+        warn!("RDPSND DVC: channel opened (AUDIO_PLAYBACK_DVC)");
+        // RDPSND is server-initiated; nothing to send on start.
+        Ok(Vec::new())
+    }
+
+    fn process(
+        &mut self,
+        _channel_id: u32,
+        payload: &[u8],
+    ) -> PduResult<Vec<DvcMessage>> {
+        // Delegate to the inner Rdpsnd SvcProcessor.
+        // It returns Vec<SvcMessage> — we need to convert
+        // each to DvcMessage by encoding the inner PDU bytes.
+        let svc_messages = self.inner.process(payload)?;
+
+        let mut dvc_messages: Vec<DvcMessage> = Vec::new();
+        for svc_msg in svc_messages {
+            // SvcMessage::encode_unframed_pdu() gives us the raw
+            // PDU bytes without SVC channel framing headers.
+            let raw_bytes = svc_msg.encode_unframed_pdu()
+                .map_err(|e| ironrdp::pdu::pdu_other_err!(
+                    "RdpsndDvc",
+                    "failed to encode response PDU: {e}"
+                ))?;
+            dvc_messages.push(Box::new(RawRdpsndDvcMsg(raw_bytes)));
+        }
+
+        Ok(dvc_messages)
+    }
+
+    fn close(&mut self, _channel_id: u32) {
+        warn!("RDPSND DVC: channel closed");
+    }
+}
