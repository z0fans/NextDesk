diff --git a/crates/ironrdp-web/src/gfx.rs b/crates/ironrdp-web/src/gfx.rs
new file mode 100644
index 0000000..a85a3b6
--- /dev/null
+++ b/crates/ironrdp-web/src/gfx.rs
@@ -0,0 +1,412 @@
+use std::fmt::Write as _;
+
+use ironrdp_egfx::client::{
+    ClearCodecFrameDecoder, GraphicsPipelineHandler, avc420_capabilities, extract_avc420_frame,
+};
+use ironrdp_egfx::pdu::{CapabilitySet, Codec1Type, GfxPdu};
+use tracing::{debug, trace, warn};
+use wasm_bindgen::JsValue;
+
+/// WASM GFX handler: forwards H.264 NAL units and surface management
+/// events to JavaScript via callback functions.
+pub(crate) struct WasmGfxHandler {
+    /// JS callback: (type: string, data: Uint8Array | object) => void
+    callback: js_sys::Function,
+    clearcodec_decoder: ClearCodecFrameDecoder,
+}
+
+impl WasmGfxHandler {
+    pub(crate) fn new(callback: js_sys::Function) -> Self {
+        Self {
+            callback,
+            clearcodec_decoder: ClearCodecFrameDecoder::new(),
+        }
+    }
+
+    fn call_js(&self, event_type: &str, data: &JsValue) {
+        let args = js_sys::Array::new();
+        args.push(&JsValue::from_str(event_type));
+        args.push(data);
+        if let Err(e) = self.callback.apply(&JsValue::NULL, &args) {
+            warn!("GFX JS callback failed: {e:?}");
+        }
+    }
+}
+
+fn hex_prefix(bytes: &[u8], max_len: usize) -> String {
+    let mut hex = String::with_capacity(bytes.len().min(max_len) * 2);
+    for byte in bytes.iter().take(max_len) {
+        let _ = write!(&mut hex, "{byte:02x}");
+    }
+    hex
+}
+
+fn color_to_rgba_u32(color: &ironrdp_egfx::pdu::Color) -> u32 {
+    u32::from(color.r) | (u32::from(color.g) << 8) | (u32::from(color.b) << 16) | (u32::from(color.xa) << 24)
+}
+
+// SAFETY: WASM is single-threaded, so Send is safe
+unsafe impl Send for WasmGfxHandler {}
+
+impl GraphicsPipelineHandler for WasmGfxHandler {
+    fn capabilities(&self) -> Vec<CapabilitySet> {
+        avc420_capabilities()
+    }
+
+    fn handle_pdu(&mut self, pdu: GfxPdu) -> Option<GfxPdu> {
+        match pdu {
+            GfxPdu::WireToSurface1(w2s) => {
+                let codec_name = match w2s.codec_id {
+                    Codec1Type::Uncompressed => "uncompressed",
+                    Codec1Type::RemoteFx => "remotefx",
+                    Codec1Type::ClearCodec => "clearcodec",
+                    Codec1Type::Planar => "planar",
+                    Codec1Type::Avc420 => "h264",
+                    Codec1Type::Alpha => "alpha",
+                    Codec1Type::Avc444 => "h264-avc444",
+                    Codec1Type::Avc444v2 => "h264-avc444v2",
+                };
+
+                debug!(
+                    codec = codec_name,
+                    surface_id = w2s.surface_id,
+                    data_len = w2s.bitmap_data.len(),
+                    "GFX WireToSurface1"
+                );
+
+                // The current web path supports one AVC420 stream. AVC444 needs a separate compositor.
+                let is_avc420 = matches!(w2s.codec_id, Codec1Type::Avc420);
+                let is_clearcodec = matches!(w2s.codec_id, Codec1Type::ClearCodec);
+
+                let codec_obj = js_sys::Object::new();
+                let _ = js_sys::Reflect::set(&codec_obj, &"surfaceId".into(), &w2s.surface_id.into());
+                let _ = js_sys::Reflect::set(&codec_obj, &"codec".into(), &codec_name.into());
+                let _ = js_sys::Reflect::set(&codec_obj, &"h264".into(), &JsValue::from_bool(is_avc420));
+                let _ = js_sys::Reflect::set(
+                    &codec_obj,
+                    &"dataLen".into(),
+                    &JsValue::from_f64(w2s.bitmap_data.len() as f64),
+                );
+                let _ = js_sys::Reflect::set(&codec_obj, &"left".into(), &w2s.destination_rectangle.left.into());
+                let _ = js_sys::Reflect::set(&codec_obj, &"top".into(), &w2s.destination_rectangle.top.into());
+                let _ = js_sys::Reflect::set(&codec_obj, &"right".into(), &w2s.destination_rectangle.right.into());
+                let _ = js_sys::Reflect::set(&codec_obj, &"bottom".into(), &w2s.destination_rectangle.bottom.into());
+                let codec_event: JsValue = codec_obj.into();
+                self.call_js("gfx_codec", &codec_event);
+
+                if is_avc420 {
+                    match extract_avc420_frame(&w2s.bitmap_data) {
+                        Ok(frame) => {
+                            let rect = frame.rectangles.first().unwrap_or(&w2s.destination_rectangle);
+                            let data = js_sys::Uint8Array::from(frame.data);
+                            let obj = js_sys::Object::new();
+                            let _ = js_sys::Reflect::set(&obj, &"surfaceId".into(), &w2s.surface_id.into());
+                            let _ = js_sys::Reflect::set(&obj, &"codec".into(), &codec_name.into());
+                            let _ = js_sys::Reflect::set(&obj, &"data".into(), &data);
+                            let _ = js_sys::Reflect::set(&obj, &"left".into(), &rect.left.into());
+                            let _ = js_sys::Reflect::set(&obj, &"top".into(), &rect.top.into());
+                            let _ = js_sys::Reflect::set(&obj, &"right".into(), &rect.right.into());
+                            let _ = js_sys::Reflect::set(&obj, &"bottom".into(), &rect.bottom.into());
+                            self.call_js("h264_frame", &obj.into());
+                        }
+                        Err(error) => {
+                            warn!(?error, "Failed to decode AVC420 bitmap stream");
+                            let obj = js_sys::Object::new();
+                            let _ = js_sys::Reflect::set(&obj, &"surfaceId".into(), &w2s.surface_id.into());
+                            let _ = js_sys::Reflect::set(&obj, &"codec".into(), &codec_name.into());
+                            let _ = js_sys::Reflect::set(
+                                &obj,
+                                &"detail".into(),
+                                &format!("avc420 decode error: {error}").into(),
+                            );
+                            self.call_js("unsupported_codec", &obj.into());
+                        }
+                    }
+                } else if is_clearcodec {
+                    let clearcodec_width = w2s
+                        .destination_rectangle
+                        .right
+                        .saturating_sub(w2s.destination_rectangle.left);
+                    let clearcodec_height = w2s
+                        .destination_rectangle
+                        .bottom
+                        .saturating_sub(w2s.destination_rectangle.top);
+                    match self
+                        .clearcodec_decoder
+                        .decode_frame(&w2s.bitmap_data, clearcodec_width, clearcodec_height)
+                    {
+                        Ok(frame) => {
+                            let first_patch = frame.patches.first();
+                            let obj = js_sys::Object::new();
+                            let _ = js_sys::Reflect::set(&obj, &"surfaceId".into(), &w2s.surface_id.into());
+                            let _ = js_sys::Reflect::set(&obj, &"codec".into(), &codec_name.into());
+                            let _ = js_sys::Reflect::set(
+                                &obj,
+                                &"width".into(),
+                                &first_patch.map_or(0, |patch| patch.width).into(),
+                            );
+                            let _ = js_sys::Reflect::set(
+                                &obj,
+                                &"height".into(),
+                                &first_patch.map_or(0, |patch| patch.height).into(),
+                            );
+                            let _ = js_sys::Reflect::set(&obj, &"flags".into(), &frame.flags.into());
+                            let _ = js_sys::Reflect::set(
+                                &obj,
+                                &"glyphIndex".into(),
+                                &JsValue::from_bool(frame.glyph_index_present),
+                            );
+                            let _ = js_sys::Reflect::set(
+                                &obj,
+                                &"glyphHit".into(),
+                                &JsValue::from_bool(frame.glyph_hit_present),
+                            );
+                            let _ = js_sys::Reflect::set(
+                                &obj,
+                                &"cacheReset".into(),
+                                &JsValue::from_bool(frame.cache_reset),
+                            );
+                            let _ = js_sys::Reflect::set(
+                                &obj,
+                                &"residual".into(),
+                                &JsValue::from_bool(frame.residual_byte_count != 0),
+                            );
+                            let _ = js_sys::Reflect::set(
+                                &obj,
+                                &"banding".into(),
+                                &JsValue::from_bool(frame.bands_byte_count != 0),
+                            );
+                            let _ = js_sys::Reflect::set(
+                                &obj,
+                                &"subcodec".into(),
+                                &JsValue::from_bool(frame.subcodec_byte_count != 0),
+                            );
+                            let _ = js_sys::Reflect::set(&obj, &"sequenceNumber".into(), &frame.sequence_number.into());
+                            let _ = js_sys::Reflect::set(
+                                &obj,
+                                &"payloadLen".into(),
+                                &JsValue::from_f64(frame.payload_len as f64),
+                            );
+                            let _ = js_sys::Reflect::set(
+                                &obj,
+                                &"residualByteCount".into(),
+                                &JsValue::from_f64(frame.residual_byte_count as f64),
+                            );
+                            let _ = js_sys::Reflect::set(
+                                &obj,
+                                &"bandsByteCount".into(),
+                                &JsValue::from_f64(frame.bands_byte_count as f64),
+                            );
+                            let _ = js_sys::Reflect::set(
+                                &obj,
+                                &"subcodecByteCount".into(),
+                                &JsValue::from_f64(frame.subcodec_byte_count as f64),
+                            );
+                            let _ = js_sys::Reflect::set(
+                                &obj,
+                                &"patchCount".into(),
+                                &JsValue::from_f64(frame.patches.len() as f64),
+                            );
+                            let _ = js_sys::Reflect::set(
+                                &obj,
+                                &"bitmapHexPrefix".into(),
+                                &hex_prefix(&w2s.bitmap_data, 96).into(),
+                            );
+                            let _ = js_sys::Reflect::set(
+                                &obj,
+                                &"payloadHexPrefix".into(),
+                                &hex_prefix(&w2s.bitmap_data[2..], 96).into(),
+                            );
+                            let _ = js_sys::Reflect::set(
+                                &obj,
+                                &"hexPrefix".into(),
+                                &hex_prefix(&w2s.bitmap_data, 96).into(),
+                            );
+                            let _ = js_sys::Reflect::set(&obj, &"left".into(), &w2s.destination_rectangle.left.into());
+                            let _ = js_sys::Reflect::set(&obj, &"top".into(), &w2s.destination_rectangle.top.into());
+                            let _ =
+                                js_sys::Reflect::set(&obj, &"right".into(), &w2s.destination_rectangle.right.into());
+                            let _ =
+                                js_sys::Reflect::set(&obj, &"bottom".into(), &w2s.destination_rectangle.bottom.into());
+                            let clearcodec_event: JsValue = obj.into();
+                            self.call_js("clearcodec_frame", &clearcodec_event);
+
+                            for patch in &frame.patches {
+                                let left = w2s.destination_rectangle.left.saturating_add(patch.x);
+                                let top = w2s.destination_rectangle.top.saturating_add(patch.y);
+                                let right = left.saturating_add(patch.width);
+                                let bottom = top.saturating_add(patch.height);
+                                let data = js_sys::Uint8Array::from(patch.rgba.as_slice());
+                                let patch_obj = js_sys::Object::new();
+                                let _ = js_sys::Reflect::set(&patch_obj, &"surfaceId".into(), &w2s.surface_id.into());
+                                let _ = js_sys::Reflect::set(&patch_obj, &"codec".into(), &codec_name.into());
+                                let _ = js_sys::Reflect::set(&patch_obj, &"data".into(), &data);
+                                let _ = js_sys::Reflect::set(&patch_obj, &"left".into(), &left.into());
+                                let _ = js_sys::Reflect::set(&patch_obj, &"top".into(), &top.into());
+                                let _ = js_sys::Reflect::set(&patch_obj, &"right".into(), &right.into());
+                                let _ = js_sys::Reflect::set(&patch_obj, &"bottom".into(), &bottom.into());
+                                let _ = js_sys::Reflect::set(&patch_obj, &"width".into(), &patch.width.into());
+                                let _ = js_sys::Reflect::set(&patch_obj, &"height".into(), &patch.height.into());
+                                self.call_js("clearcodec_rgba_patch", &patch_obj.into());
+                            }
+                        }
+                        Err(error) => {
+                            warn!(?error, "Failed to decode ClearCodec bitmap data");
+                            let obj = js_sys::Object::new();
+                            let _ = js_sys::Reflect::set(&obj, &"surfaceId".into(), &w2s.surface_id.into());
+                            let _ = js_sys::Reflect::set(&obj, &"codec".into(), &codec_name.into());
+                            let _ = js_sys::Reflect::set(
+                                &obj,
+                                &"detail".into(),
+                                &format!("clearcodec decode error: {error}").into(),
+                            );
+                            let _ = js_sys::Reflect::set(
+                                &obj,
+                                &"bitmapHexPrefix".into(),
+                                &hex_prefix(&w2s.bitmap_data, 96).into(),
+                            );
+                            let payload_hex = if w2s.bitmap_data.len() > 2 {
+                                hex_prefix(&w2s.bitmap_data[2..], 96)
+                            } else {
+                                String::new()
+                            };
+                            let _ = js_sys::Reflect::set(&obj, &"payloadHexPrefix".into(), &payload_hex.into());
+                            self.call_js("unsupported_codec", &obj.into());
+                        }
+                    }
+                } else {
+                    self.call_js("unsupported_codec", &codec_event);
+                    trace!(codec = codec_name, "Non-H.264 codec, skipping JS callback");
+                }
+            }
+            GfxPdu::CreateSurface(cs) => {
+                debug!(
+                    surface_id = cs.surface_id,
+                    width = cs.width,
+                    height = cs.height,
+                    "GFX CreateSurface"
+                );
+                let obj = js_sys::Object::new();
+                let _ = js_sys::Reflect::set(&obj, &"surfaceId".into(), &cs.surface_id.into());
+                let _ = js_sys::Reflect::set(&obj, &"width".into(), &cs.width.into());
+                let _ = js_sys::Reflect::set(&obj, &"height".into(), &cs.height.into());
+                self.call_js("create_surface", &obj.into());
+            }
+            GfxPdu::SolidFill(pdu) => {
+                debug!(
+                    surface_id = pdu.surface_id,
+                    rect_count = pdu.rectangles.len(),
+                    "GFX SolidFill"
+                );
+                for rect in &pdu.rectangles {
+                    let obj = js_sys::Object::new();
+                    let _ = js_sys::Reflect::set(&obj, &"surfaceId".into(), &pdu.surface_id.into());
+                    let _ = js_sys::Reflect::set(&obj, &"left".into(), &rect.left.into());
+                    let _ = js_sys::Reflect::set(&obj, &"top".into(), &rect.top.into());
+                    let _ = js_sys::Reflect::set(&obj, &"right".into(), &rect.right.into());
+                    let _ = js_sys::Reflect::set(&obj, &"bottom".into(), &rect.bottom.into());
+                    let _ = js_sys::Reflect::set(
+                        &obj,
+                        &"color".into(),
+                        &JsValue::from_f64(color_to_rgba_u32(&pdu.fill_pixel) as f64),
+                    );
+                    self.call_js("solid_fill", &obj.into());
+                }
+            }
+            GfxPdu::SurfaceToSurface(pdu) => {
+                debug!(
+                    src_surface_id = pdu.source_surface_id,
+                    dst_surface_id = pdu.destination_surface_id,
+                    point_count = pdu.destination_points.len(),
+                    "GFX SurfaceToSurface"
+                );
+                for dest in &pdu.destination_points {
+                    let obj = js_sys::Object::new();
+                    let _ = js_sys::Reflect::set(&obj, &"srcSurfaceId".into(), &pdu.source_surface_id.into());
+                    let _ = js_sys::Reflect::set(&obj, &"dstSurfaceId".into(), &pdu.destination_surface_id.into());
+                    let _ = js_sys::Reflect::set(&obj, &"srcLeft".into(), &pdu.source_rectangle.left.into());
+                    let _ = js_sys::Reflect::set(&obj, &"srcTop".into(), &pdu.source_rectangle.top.into());
+                    let _ = js_sys::Reflect::set(&obj, &"srcRight".into(), &pdu.source_rectangle.right.into());
+                    let _ = js_sys::Reflect::set(&obj, &"srcBottom".into(), &pdu.source_rectangle.bottom.into());
+                    let _ = js_sys::Reflect::set(&obj, &"dstX".into(), &dest.x.into());
+                    let _ = js_sys::Reflect::set(&obj, &"dstY".into(), &dest.y.into());
+                    self.call_js("surface_to_surface", &obj.into());
+                }
+            }
+            GfxPdu::SurfaceToCache(pdu) => {
+                debug!(
+                    surface_id = pdu.surface_id,
+                    cache_slot = pdu.cache_slot,
+                    "GFX SurfaceToCache"
+                );
+                let obj = js_sys::Object::new();
+                let _ = js_sys::Reflect::set(&obj, &"surfaceId".into(), &pdu.surface_id.into());
+                let _ = js_sys::Reflect::set(&obj, &"cacheSlot".into(), &pdu.cache_slot.into());
+                let _ = js_sys::Reflect::set(&obj, &"cacheKey".into(), &pdu.cache_key.to_string().into());
+                let _ = js_sys::Reflect::set(&obj, &"left".into(), &pdu.source_rectangle.left.into());
+                let _ = js_sys::Reflect::set(&obj, &"top".into(), &pdu.source_rectangle.top.into());
+                let _ = js_sys::Reflect::set(&obj, &"right".into(), &pdu.source_rectangle.right.into());
+                let _ = js_sys::Reflect::set(&obj, &"bottom".into(), &pdu.source_rectangle.bottom.into());
+                self.call_js("surface_to_cache", &obj.into());
+            }
+            GfxPdu::CacheToSurface(pdu) => {
+                debug!(
+                    surface_id = pdu.surface_id,
+                    cache_slot = pdu.cache_slot,
+                    point_count = pdu.destination_points.len(),
+                    "GFX CacheToSurface"
+                );
+                for dest in &pdu.destination_points {
+                    let obj = js_sys::Object::new();
+                    let _ = js_sys::Reflect::set(&obj, &"surfaceId".into(), &pdu.surface_id.into());
+                    let _ = js_sys::Reflect::set(&obj, &"cacheSlot".into(), &pdu.cache_slot.into());
+                    let _ = js_sys::Reflect::set(&obj, &"dstX".into(), &dest.x.into());
+                    let _ = js_sys::Reflect::set(&obj, &"dstY".into(), &dest.y.into());
+                    self.call_js("cache_to_surface", &obj.into());
+                }
+            }
+            GfxPdu::EvictCacheEntry(pdu) => {
+                debug!(cache_slot = pdu.cache_slot, "GFX EvictCacheEntry");
+                let obj = js_sys::Object::new();
+                let _ = js_sys::Reflect::set(&obj, &"cacheSlot".into(), &pdu.cache_slot.into());
+                self.call_js("evict_cache", &obj.into());
+            }
+            GfxPdu::DeleteSurface(ds) => {
+                debug!(surface_id = ds.surface_id, "GFX DeleteSurface");
+                self.call_js("delete_surface", &ds.surface_id.into());
+            }
+            GfxPdu::MapSurfaceToOutput(map) => {
+                debug!(
+                    surface_id = map.surface_id,
+                    x = map.output_origin_x,
+                    y = map.output_origin_y,
+                    "GFX MapSurfaceToOutput"
+                );
+                let obj = js_sys::Object::new();
+                let _ = js_sys::Reflect::set(&obj, &"surfaceId".into(), &map.surface_id.into());
+                let _ = js_sys::Reflect::set(&obj, &"x".into(), &map.output_origin_x.into());
+                let _ = js_sys::Reflect::set(&obj, &"y".into(), &map.output_origin_y.into());
+                self.call_js("map_surface", &obj.into());
+            }
+            GfxPdu::StartFrame(sf) => {
+                trace!(frame_id = sf.frame_id, "GFX StartFrame");
+                self.call_js("start_frame", &sf.frame_id.into());
+            }
+            GfxPdu::EndFrame(ef) => {
+                trace!(frame_id = ef.frame_id, "GFX EndFrame");
+                self.call_js("end_frame", &ef.frame_id.into());
+            }
+            GfxPdu::ResetGraphics(rg) => {
+                debug!(width = rg.width, height = rg.height, "GFX ResetGraphics");
+                let obj = js_sys::Object::new();
+                let _ = js_sys::Reflect::set(&obj, &"width".into(), &rg.width.into());
+                let _ = js_sys::Reflect::set(&obj, &"height".into(), &rg.height.into());
+                self.call_js("reset_graphics", &obj.into());
+            }
+            other => {
+                trace!(?other, "GFX PDU (unhandled)");
+            }
+        }
+        None
+    }
+}
diff --git a/crates/ironrdp-web/src/image.rs b/crates/ironrdp-web/src/image.rs
index 13ac3fe..1d2459f 100644
--- a/crates/ironrdp-web/src/image.rs
+++ b/crates/ironrdp-web/src/image.rs
@@ -3,6 +3,24 @@
 use ironrdp::pdu::geometry::{InclusiveRectangle, Rectangle as _};
 use ironrdp::session::image::DecodedImage;
 
+/// Zero-copy: returns a slice into `DecodedImage::data()` covering the full rows
+/// that contain `region`, plus the image stride (bytes per row of the full image).
+/// The caller uses WebGL2 `UNPACK_ROW_LENGTH` to upload only the needed sub-rect.
+pub(crate) fn extract_partial_image_ref<'a>(image: &'a DecodedImage, region: &InclusiveRectangle) -> (&'a [u8], u32) {
+    let pixel_size = usize::from(image.pixel_format().bytes_per_pixel());
+    let image_width = usize::from(image.width());
+    let image_stride = image_width * pixel_size;
+
+    let region_top = usize::from(region.top);
+    let region_bottom = usize::from(region.bottom);
+
+    let src = image.data();
+    let src_begin = region_top * image_stride;
+    let src_end = (region_bottom + 1) * image_stride;
+
+    (&src[src_begin..src_end], image_width as u32)
+}
