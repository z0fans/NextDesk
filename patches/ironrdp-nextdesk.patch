+/// Zero-copy: returns a slice into `DecodedImage::data()` covering the full rows
+/// that contain `region`, plus the image stride (bytes per row of the full image).
+/// The caller uses WebGL2 `UNPACK_ROW_LENGTH` to upload only the needed sub-rect.
+pub(crate) fn extract_partial_image_ref<'a>(image: &'a DecodedImage, region: &InclusiveRectangle) -> (&'a [u8], u32) {
+    let pixel_size = usize::from(image.pixel_format().bytes_per_pixel());
+    let image_width = usize::from(image.width());
+    let image_stride = image_width * pixel_size;
+
+    let region_top = usize::from(region.top);
+    let region_bottom = usize::from(region.bottom);
+
+    let src = image.data();
+    let src_begin = region_top * image_stride;
+    let src_end = (region_bottom + 1) * image_stride;
+
+    (&src[src_begin..src_end], image_width as u32)
+}
