+fn encode_snapshot_thumbnail_data_url(image: &DecodedImage) -> anyhow::Result<String> {
+    const MAX_THUMBNAIL_WIDTH: u32 = 640;
+    const MAX_THUMBNAIL_HEIGHT: u32 = 360;
+
+    let src_width = u32::from(image.width());
+    let src_height = u32::from(image.height());
+    if src_width == 0 || src_height == 0 {
+        anyhow::bail!("source image is empty");
+    }
+
+    let mut dst_width = src_width;
+    let mut dst_height = src_height;
+    if dst_width > MAX_THUMBNAIL_WIDTH {
+        dst_height = (dst_height * MAX_THUMBNAIL_WIDTH / dst_width).max(1);
+        dst_width = MAX_THUMBNAIL_WIDTH;
+    }
+    if dst_height > MAX_THUMBNAIL_HEIGHT {
+        dst_width = (dst_width * MAX_THUMBNAIL_HEIGHT / dst_height).max(1);
+        dst_height = MAX_THUMBNAIL_HEIGHT;
+    }
+
+    let src = image.data();
+    let expected_len = usize::try_from(src_width * src_height * 4).context("thumbnail source size overflow")?;
+    if src.len() < expected_len {
+        anyhow::bail!("source image buffer is too small");
+    }
+
+    let dst_len = usize::try_from(dst_width * dst_height * 4).context("thumbnail destination size overflow")?;
+    let mut dst = vec![0u8; dst_len];
+
+    for y in 0..dst_height {
+        let src_y = y * src_height / dst_height;
+        for x in 0..dst_width {
+            let src_x = x * src_width / dst_width;
+            let src_offset = usize::try_from((src_y * src_width + src_x) * 4).context("source offset overflow")?;
+            let dst_offset = usize::try_from((y * dst_width + x) * 4).context("destination offset overflow")?;
+
+            dst[dst_offset] = src[src_offset];
+            dst[dst_offset + 1] = src[src_offset + 1];
+            dst[dst_offset + 2] = src[src_offset + 2];
+            dst[dst_offset + 3] = 255;
+        }
+    }
+
+    let mut png_buffer = Vec::new();
+    {
+        let mut encoder = png::Encoder::new(&mut png_buffer, dst_width, dst_height);
+        encoder.set_color(png::ColorType::Rgba);
+        encoder.set_depth(png::BitDepth::Eight);
+        encoder.set_compression(png::Compression::Fast);
+        let mut writer = encoder.write_header().context("PNG encoder header write failed")?;
+        writer
+            .write_image_data(&dst)
+            .context("failed to encode snapshot thumbnail PNG")?;
+    }
+
+    let mut data_url = "data:image/png;base64,".to_owned();
+    base64::engine::general_purpose::STANDARD.encode_string(png_buffer, &mut data_url);
+    Ok(data_url)
+}
