+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Avc420Frame<'a> {
+    pub rectangles: Vec<InclusiveRectangle>,
+    pub data: &'a [u8],
+}
+
+pub fn avc420_capabilities() -> Vec<CapabilitySet> {
+    vec![
+        CapabilitySet::V8_1 {
+            flags: CapabilitiesV81Flags::AVC420_ENABLED | CapabilitiesV81Flags::SMALL_CACHE,
+        },
+        CapabilitySet::V8 {
+            flags: CapabilitiesV8Flags::SMALL_CACHE,
+        },
+    ]
+}
+
+pub fn extract_avc420_frame(bitmap_data: &[u8]) -> DecodeResult<Avc420Frame<'_>> {
+    let stream: Avc420BitmapStream<'_> = decode(bitmap_data)?;
+    Ok(Avc420Frame {
+        rectangles: stream.rectangles,
+        data: stream.data,
+    })
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct ClearCodecRgbaPatch {
+    pub x: u16,
+    pub y: u16,
+    pub width: u16,
+    pub height: u16,
+    pub rgba: Vec<u8>,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct ClearCodecFrame {
+    pub flags: u8,
+    pub glyph_index_present: bool,
+    pub glyph_hit_present: bool,
+    pub cache_reset: bool,
+    pub sequence_number: u8,
+    pub payload_len: usize,
+    pub residual_byte_count: u32,
+    pub bands_byte_count: u32,
+    pub subcodec_byte_count: u32,
+    pub patches: Vec<ClearCodecRgbaPatch>,
+}
+
+pub struct ClearCodecFrameDecoder {
+    decoder: clearcodec::ClearCodecDecoder,
+}
+
+impl ClearCodecFrameDecoder {
+    pub fn new() -> Self {
+        Self {
+            decoder: clearcodec::ClearCodecDecoder::new(),
+        }
+    }
+
+    pub fn decode_frame(&mut self, bitmap_data: &[u8], width: u16, height: u16) -> DecodeResult<ClearCodecFrame> {
+        let mut cursor = ReadCursor::new(bitmap_data);
+        let stream = ironrdp_pdu::codecs::clearcodec::ClearCodecBitmapStream::decode(&mut cursor)?;
+        let flags = stream.flags;
+        let glyph_index_present = stream.has_glyph_index();
+        let glyph_hit_present = stream.is_glyph_hit();
+        let cache_reset = stream.is_cache_reset();
+        let sequence_number = stream.seq_number;
+        let header_len = 2 + usize::from(glyph_index_present) * 2;
+        let payload_len = bitmap_data.len().saturating_sub(header_len);
+        let residual_byte_count = stream.composite.as_ref().map_or(0, |c| c.residual_data.len() as u32);
+        let bands_byte_count = stream.composite.as_ref().map_or(0, |c| c.bands_data.len() as u32);
+        let subcodec_byte_count = stream.composite.as_ref().map_or(0, |c| c.subcodec_data.len() as u32);
+        let should_draw = glyph_hit_present || stream.composite.is_some();
+
+        let bgra = self.decoder.decode(bitmap_data, width, height)?;
+        let mut patches = Vec::new();
+        if should_draw && width != 0 && height != 0 && !bgra.is_empty() {
+            patches.push(ClearCodecRgbaPatch {
+                x: 0,
+                y: 0,
+                width,
+                height,
+                rgba: bgra_to_rgba(bgra),
+            });
+        }
+
+        Ok(ClearCodecFrame {
+            flags,
+            glyph_index_present,
+            glyph_hit_present,
+            cache_reset,
+            sequence_number,
+            payload_len,
+            residual_byte_count,
+            bands_byte_count,
+            subcodec_byte_count,
+            patches,
+        })
+    }
+}
+
+impl Default for ClearCodecFrameDecoder {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+pub fn extract_clearcodec_frame(bitmap_data: &[u8], width: u16, height: u16) -> DecodeResult<ClearCodecFrame> {
+    ClearCodecFrameDecoder::new().decode_frame(bitmap_data, width, height)
+}
+
+fn bgra_to_rgba(mut bgra: Vec<u8>) -> Vec<u8> {
+    for pixel in bgra.chunks_exact_mut(4) {
+        pixel.swap(0, 2);
+    }
+    bgra
+}
