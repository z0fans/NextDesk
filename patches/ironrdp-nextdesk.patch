+#[cfg(test)]
+mod tests {
+    use ironrdp_pdu::geometry::InclusiveRectangle;
+    use ironrdp_pdu::{Encode as _, WriteCursor};
+
+    use super::{avc420_capabilities, extract_avc420_frame, extract_clearcodec_frame, ClearCodecFrameDecoder};
+    use crate::pdu::{Avc420BitmapStream, CapabilitiesV81Flags, CapabilitiesV8Flags, CapabilitySet, QuantQuality};
+
+    #[test]
+    fn avc420_capabilities_advertise_v81_before_v8() {
+        let caps = avc420_capabilities();
+
+        assert!(matches!(
+            caps.as_slice(),
+            [
+                CapabilitySet::V8_1 { flags: v81 },
+                CapabilitySet::V8 { flags: v8 },
+            ] if v81.contains(CapabilitiesV81Flags::AVC420_ENABLED)
+                && v81.contains(CapabilitiesV81Flags::SMALL_CACHE)
+                && v8.contains(CapabilitiesV8Flags::SMALL_CACHE)
+        ));
+    }
+
+    #[test]
+    fn extract_avc420_frame_returns_inner_h264_payload() {
+        let h264 = [0, 0, 0, 1, 0x67, 0x42, 0, 0x1f];
+        let stream = Avc420BitmapStream {
+            rectangles: vec![InclusiveRectangle {
+                left: 10,
+                top: 20,
+                right: 110,
+                bottom: 120,
+            }],
+            quant_qual_vals: vec![QuantQuality {
+                quantization_parameter: 22,
+                progressive: false,
+                quality: 100,
+            }],
+            data: &h264,
+        };
+
+        let mut encoded = vec![0; stream.size()];
+        let mut cursor = WriteCursor::new(&mut encoded);
+        stream.encode(&mut cursor).expect("encode avc420 test stream");
+
+        let frame = extract_avc420_frame(&encoded).expect("decode avc420 frame");
+
+        assert_eq!(frame.data, h264);
+        assert_eq!(frame.rectangles.len(), 1);
+        assert_eq!(frame.rectangles[0].left, 10);
+    }
+
+    #[test]
+    fn extract_clearcodec_frame_returns_metadata_and_payload() {
+        let encoded = [
+            0x00, 0x00, // ccFlags, seqNumber
+            0x00, 0x00, 0x00, 0x00, // residualByteCount
+            0x00, 0x00, 0x00, 0x00, // bandsByteCount
+            0x15, 0x00, 0x00, 0x00, // subcodecByteCount
+            0x00, 0x00, // xStart
+            0x00, 0x00, // yStart
+            0x28, 0x00, // width
+            0x40, 0x00, // height
+            0x08, 0x00, 0x00, 0x00, // bitmapDataByteCount
+            0x02, // subCodecId RLEX
+            0x01, 0x00, 0x00, 0x00, 0x00, 0xff, 0xff, 0x09,
+        ];
+
+        let frame = extract_clearcodec_frame(&encoded, 40, 64).expect("decode clearcodec frame");
+
+        assert_eq!(frame.flags, 0);
+        assert!(!frame.glyph_index_present);
+        assert!(!frame.glyph_hit_present);
+        assert!(!frame.cache_reset);
+        assert_eq!(frame.sequence_number, 0);
+        assert_eq!(frame.payload_len, 33);
+        assert_eq!(frame.residual_byte_count, 0);
+        assert_eq!(frame.bands_byte_count, 0);
+        assert_eq!(frame.subcodec_byte_count, 21);
+        assert_eq!(frame.patches.len(), 1);
+        assert_eq!(frame.patches[0].x, 0);
+        assert_eq!(frame.patches[0].y, 0);
+        assert_eq!(frame.patches[0].width, 40);
+        assert_eq!(frame.patches[0].height, 64);
+        assert_eq!(frame.patches[0].rgba.len(), 40 * 64 * 4);
+    }
+
+    #[test]
+    fn clearcodec_decoder_preserves_glyph_cache_between_frames() {
+        let mut decoder = ClearCodecFrameDecoder::new();
+        let mut first = Vec::new();
+        first.push(0x01); // FLAG_GLYPH_INDEX
+        first.push(0x00);
+        first.extend_from_slice(&7u16.to_le_bytes());
+        first.extend_from_slice(&4u32.to_le_bytes());
+        first.extend_from_slice(&0u32.to_le_bytes());
+        first.extend_from_slice(&0u32.to_le_bytes());
+        first.extend_from_slice(&[0x00, 0x00, 0xff, 0x01]);
+
+        let first_frame = decoder.decode_frame(&first, 1, 1).expect("decode and cache glyph");
+        assert_eq!(first_frame.patches.len(), 1);
+        assert_eq!(first_frame.patches[0].rgba, vec![0xff, 0x00, 0x00, 0xff]);
+
+        let mut hit = Vec::new();
+        hit.push(0x03); // FLAG_GLYPH_INDEX | FLAG_GLYPH_HIT
+        hit.push(0x01);
+        hit.extend_from_slice(&7u16.to_le_bytes());
+
+        let hit_frame = decoder.decode_frame(&hit, 1, 1).expect("decode glyph hit");
+        assert!(hit_frame.glyph_hit_present);
+        assert_eq!(hit_frame.patches.len(), 1);
+        assert_eq!(hit_frame.patches[0].rgba, first_frame.patches[0].rgba);
+    }
+}
